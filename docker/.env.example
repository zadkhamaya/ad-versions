# Variable NAMES for the two 600 env files of the deploy user; values are filled on the box, never committed.
# Names and units checked 2026-11-21 against n8n 2.46.6 (packages/@n8n/config/src/configs/endpoints.config.ts,
# packages/@n8n/config/src/index.ts) and docs.n8n.io environment-variables pages.

# --- ~/.ad-versions/n8n.env ---
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
# WEBHOOK_URL is deprecated since n8n 2.35.0 (still an alias); 2.46.6 reads N8N_WEBHOOK_URL
N8N_WEBHOOK_URL=https://n8n.example.com/
# set your IANA time zone
GENERIC_TIMEZONE=UTC
# generate on the box: python3 -c "import secrets;print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=
# keep uploads on disk, not in the 1 GB of memory
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
# the Read/Write Files nodes are refused outside n8n's own folder without this; the workflow writes under /data
N8N_RESTRICT_FILE_ACCESS_TO=/data
# the Code nodes may require('crypto'): the contact sheet's public link carries a random per-run token made with it
NODE_FUNCTION_ALLOW_BUILTIN=crypto
# execution history: prune old runs (defaults on, hours); the brief and 3 frames per run sit in the execution data
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
# MiB (default 16): the largest request body n8n accepts
N8N_PAYLOAD_SIZE_MAX=100
# MiB (default 200): the largest file in a form-data payload (the brief form's upload); Cloudflare caps bodies at 100 MB
N8N_FORMDATA_FILE_SIZE_MAX=100

# --- ~/.ad-versions/media.env ---
RUNPOD_API_KEY=
VOICE_EN_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# renders (and transcriptions) at once. 1 until `docker stats` shows two 30 s 16:9 renders together under ~1.3 GB of the 1.5 GB cap; then 2
MAX_RENDERS=1
# 1: load the Whisper model at startup, so the first render does not pay the download/load inside its slot (needs internet once, then HF_HOME on the data volume)
PRELOAD_WHISPER=1
# the voice sample the service clones for every version: an R2 object key (presigned per call) and what is said in it
VOICE_SAMPLE_KEY=
VOICE_SAMPLE_TRANSCRIPT=
# x264 threads per render (a graded 30 s 16:9 render peaked at 824 MB, so two at once may not fit in the 1.5 GB cap)
X264_THREADS=2
